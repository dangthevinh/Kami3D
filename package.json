{
  "name": "kami3d",
  "version": "0.1.0",
  "private": true,
  "description": "Kami3D — 3D World Wildlife Encyclopedia",
  "scripts": {
    "dev": "next dev -p 9000",
    "build": "next build",
    "start": "next start -p 9000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:rigs": "node --test scripts/check-rigs.mjs",
    "check:size": "node --test scripts/check-size.mjs",
    "check": "npm run typecheck && node --test scripts/check-rigs.mjs scripts/check-size.mjs scripts/check-sql.mjs scripts/check-shapes.mjs scripts/check-geo.mjs scripts/check-format.mjs scripts/check-trend.mjs scripts/check-seo.mjs scripts/check-auth-hint.mjs scripts/check-theme.mjs",
    "seed:generate": "node scripts/generate-seed.mjs",
    "check:sql": "node --test scripts/check-sql.mjs",
    "models:report": "node scripts/fetch-models.mjs --report",
    "models:fetch": "node scripts/fetch-models.mjs --all --apply --wire",
    "publish": "./scripts/publish.sh",
    "brand:icon": "node scripts/generate-icon.mjs",
    "check:shapes": "node --test scripts/check-shapes.mjs",
    "db:status": "node scripts/seed-database.mjs --status",
    "db:seed": "node scripts/seed-database.mjs",
    "db:schema": "node scripts/seed-database.mjs --schema",
    "check:geo": "node --test scripts/check-geo.mjs",
    "check:format": "node --test scripts/check-format.mjs",
    "check:trend": "node --test scripts/check-trend.mjs",
    "check:seo": "node --test scripts/check-seo.mjs",
    "check:auth": "node --test scripts/check-auth-hint.mjs",
    "check:theme": "node --test scripts/check-theme.mjs",
    "audit:perf": "node scripts/audit-browser.mjs",
    "audit:theme": "node scripts/audit-theme.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
