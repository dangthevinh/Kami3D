# ---------------------------------------------------------------------------
# Kami3D environment. Copy to .env.local and fill in. Every value is optional:
# with none of them set the app runs in "Demo Mode" (local dataset, no auth).
# ---------------------------------------------------------------------------

# --- Clerk authentication (https://dashboard.clerk.com -> API Keys) ---------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Supabase (https://supabase.com/dashboard -> Project Settings -> API) ---
# Use the *secret* key only on the server. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- 3D pipeline ------------------------------------------------------------
# Optional: vendored DRACO decoder directory (defaults to the gstatic CDN).
# Copy node_modules/three/examples/jsm/libs/draco/ into public/draco/ for offline use.
NEXT_PUBLIC_DRACO_DECODER_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:9000

# --- Ads (Phase 4) ----------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=
