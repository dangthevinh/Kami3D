# ---------------------------------------------------------------------------
# Kami3D environment template.
#
# Copy to .env.local (which is gitignored) and fill in what you need. Every value
# is optional: with none of them set the app runs in "Demo Mode" against the
# bundled dataset, with cookie-backed favourites and quiz scores.
#
# Never put a real key in THIS file — it is committed, and this repository is
# public.
# ---------------------------------------------------------------------------

# --- Clerk authentication (https://dashboard.clerk.com -> API Keys) ---------
# Both are required to enable auth; with only one set, the app stays in Demo Mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Supabase (https://supabase.com/dashboard -> Project Settings -> API) ---
# These two are PUBLIC by design (they ship to the browser), but keep them out of
# git anyway. Row level security is what protects the data, not the key.
# Either key format works: the legacy anon JWT, or the newer sb_publishable_… key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row level security: never expose it, never commit it.
# Required for favourites and quiz scores to persist per Clerk user; without it
# those features fall back to a first-party cookie.
SUPABASE_SERVICE_ROLE_KEY=

# --- 3D pipeline ------------------------------------------------------------
# Model downloads need a Sketchfab OAuth/API token:
# https://sketchfab.com/settings/password  (search works without one)
SKETCHFAB_API_TOKEN=
# Optional extras for other providers:
# SI_API_KEY=              https://api.data.gov/signup/
# POLY_PIZZA_API_KEY=      https://poly.pizza/api

# DRACO decoder location. Defaults to the vendored copy in public/draco/, which
# the compressed models from `npm run models:fetch` require. Point it at the CDN
# instead if you would rather not ship those ~1.8 MB:
#   NEXT_PUBLIC_DRACO_DECODER_PATH=https://www.gstatic.com/draco/versioned/decoders/1.5.7/
NEXT_PUBLIC_DRACO_DECODER_PATH=

NEXT_PUBLIC_SITE_URL=http://localhost:9000

# --- Ads --------------------------------------------------------------------
# Leave empty to render labelled placeholders instead of live ad units.
NEXT_PUBLIC_ADSENSE_CLIENT=
